                        <TextView style="@style/PixelItemTitle" android:text="@string/info_studio_label" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/info_studio_sub" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/itemContact" style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <FrameLayout style="@style/PixelColoredIconWrap" android:background="@drawable/bg_settings_icon_email">
                        <ImageView style="@style/PixelColoredIcon" android:src="@drawable/ic_email_outline" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_contact_label" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_contact_sub" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Footer: spacer per non far appoggiare la sezione al bordo -->
            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

