<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:titleTextColor="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <TextView style="@style/PixelPageTitle" android:text="@string/settings_title" />

            <!-- ============ ASPETTO ============ -->
            <TextView style="@style/PixelSectionTitle" android:text="@string/settings_section_appearance" />

            <com.google.android.material.card.MaterialCardView style="@style/PixelCardGroup">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingVertical="6dp">
                    <LinearLayout style="@style/PixelItemClickable" android:id="@+id/itemGridSize">
                        <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_grid" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/PixelItemTitle" android:text="@string/settings_grid_size" />
                            <TextView android:id="@+id/gridValueLabel" style="@style/PixelItemSubtitle" />
                        </LinearLayout>
                    </LinearLayout>
                    <RadioGroup
                        android:id="@+id/gridRadioGroup"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="6dp">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/gridRadio4x4" style="@style/PixelRadio" android:text="@string/settings_grid_4x4" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/gridRadio5x5" style="@style/PixelRadio" android:text="@string/settings_grid_5x5" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/gridRadio5x6" style="@style/PixelRadio" android:text="@string/settings_grid_5x6" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/PixelCardGroup">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingVertical="6dp">
                    <LinearLayout style="@style/PixelItem">
                        <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_palette" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/PixelItemTitle" android:text="@string/settings_icon_shape" />
                            <TextView android:id="@+id/iconShapeLabel" style="@style/PixelItemSubtitle" />
                        </LinearLayout>
                    </LinearLayout>
                    <RadioGroup
                        android:id="@+id/iconShapeGroup"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="6dp">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/shapeOriginal" style="@style/PixelRadio" android:text="@string/shape_original" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/shapeSquircle" style="@style/PixelRadio" android:text="@string/shape_squircle" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/shapeCircle" style="@style/PixelRadio" android:text="@string/shape_circle" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/shapeSquare" style="@style/PixelRadio" android:text="@string/shape_square" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/shapeTeardrop" style="@style/PixelRadio" android:text="@string/shape_teardrop" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_circle" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_dot_color" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_dot_color_sub" />
                        <LinearLayout
                            android:id="@+id/dotColorRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="14dp"
                            android:gravity="start" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/PixelCardGroup">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingVertical="6dp">
                    <LinearLayout style="@style/PixelItem">
                        <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_circle" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/PixelItemTitle" android:text="@string/settings_badge_mode" />
                            <TextView android:id="@+id/badgeModeLabel" style="@style/PixelItemSubtitle" />
                        </LinearLayout>
                    </LinearLayout>
                    <RadioGroup
                        android:id="@+id/badgeModeGroup"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="6dp">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/badgeDot" style="@style/PixelRadio" android:text="@string/badge_dot" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/badgeCount" style="@style/PixelRadio" android:text="@string/badge_count" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/badgeOff" style="@style/PixelRadio" android:text="@string/badge_off" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/PixelCardGroup">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingVertical="6dp">
                    <LinearLayout style="@style/PixelItem">
                        <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_swipe_up" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/PixelItemTitle" android:text="@string/settings_anim_style" />
                            <TextView android:id="@+id/animStyleLabel" style="@style/PixelItemSubtitle" />
                        </LinearLayout>
                    </LinearLayout>
                    <RadioGroup
                        android:id="@+id/animStyleGroup"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="6dp">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/animExpressive" style="@style/PixelRadio" android:text="@string/anim_expressive" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/animStandard" style="@style/PixelRadio" android:text="@string/anim_standard" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/animNone" style="@style/PixelRadio" android:text="@string/anim_none" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_widgets" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_show_widget" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_show_widget_sub" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchShowWidget"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ AI LAUNCHER MODE (v30) ============ -->
            <TextView style="@style/PixelSectionTitle" android:text="@string/settings_section_ai" />

            <com.google.android.material.card.MaterialCardView style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_circle" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_ai_launcher_mode" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_ai_launcher_mode_sub" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAiMode"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_pages" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_landscape" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_landscape_sub" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchLandscape"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ BARRA DI RICERCA ============ -->
            <TextView style="@style/PixelSectionTitle" android:text="@string/settings_section_searchbar" />

            <com.google.android.material.card.MaterialCardView style="@style/PixelCardGroup">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingVertical="6dp">
                    <LinearLayout style="@style/PixelItem">
                        <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_search" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/PixelItemTitle" android:text="@string/settings_searchbar_style" />
                            <TextView android:id="@+id/styleValueLabel" style="@style/PixelItemSubtitle" />
                        </LinearLayout>
                    </LinearLayout>
                    <RadioGroup
                        android:id="@+id/searchStyleGroup"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="6dp">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/styleSystem" style="@style/PixelRadio" android:text="@string/style_system" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/styleTransparent" style="@style/PixelRadio" android:text="@string/style_transparent" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/styleDark" style="@style/PixelRadio" android:text="@string/style_dark" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/styleLight" style="@style/PixelRadio" android:text="@string/style_light" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/PixelCardGroup">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingVertical="6dp">
                    <LinearLayout style="@style/PixelItem">
                        <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_search" />
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_search_mode" />
                    </LinearLayout>
                    <RadioGroup
                        android:id="@+id/searchModeGroup"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="6dp">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/searchModeApps" style="@style/PixelRadio" android:text="@string/settings_search_apps" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/searchModeGoogle" style="@style/PixelRadio" android:text="@string/settings_search_google" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ DRAWER ============ -->
            <TextView style="@style/PixelSectionTitle" android:text="@string/settings_section_drawer" />

            <com.google.android.material.card.MaterialCardView style="@style/PixelCardGroup">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingVertical="6dp">
                    <LinearLayout style="@style/PixelItem">
                        <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_grid" />
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_drawer_layout" />
                    </LinearLayout>
                    <RadioGroup
                        android:id="@+id/drawerLayoutGroup"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="6dp">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/drawerLayoutGrid3" style="@style/PixelRadio" android:text="@string/drawer_grid3" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/drawerLayoutGrid4" style="@style/PixelRadio" android:text="@string/drawer_grid4" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/drawerLayoutGrid5" style="@style/PixelRadio" android:text="@string/drawer_grid5" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/drawerLayoutList" style="@style/PixelRadio" android:text="@string/drawer_list" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ CARTELLE ============ -->
            <TextView style="@style/PixelSectionTitle" android:text="@string/settings_section_folders" />

            <com.google.android.material.card.MaterialCardView style="@style/PixelCardGroup">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:paddingVertical="6dp">
                    <LinearLayout style="@style/PixelItem">
                        <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_pin" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/PixelItemTitle" android:text="@string/settings_folder_bg" />
                            <TextView android:id="@+id/folderBgLabel" style="@style/PixelItemSubtitle" />
                        </LinearLayout>
                    </LinearLayout>
                    <RadioGroup
                        android:id="@+id/folderBgGroup"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="6dp">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/folderBgSystem" style="@style/PixelRadio" android:text="@string/folder_bg_system" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/folderBgTransparent" style="@style/PixelRadio" android:text="@string/folder_bg_transparent" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/folderBgDark" style="@style/PixelRadio" android:text="@string/folder_bg_dark" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/folderBgLight" style="@style/PixelRadio" android:text="@string/folder_bg_light" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ GESTI ============ -->
            <TextView style="@style/PixelSectionTitle" android:text="@string/settings_section_gestures" />

            <com.google.android.material.card.MaterialCardView style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_swipe_up" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_swipe_down" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_swipe_down_sub" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSwipeDown"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_pin" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_double_tap_lock" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_double_tap_lock_sub" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDoubleTapLock"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_settings" />
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" style="@style/PixelItemTitle"
                        android:text="@string/settings_haptic" />
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchHaptic"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ AVANZATE ============ -->
            <TextView style="@style/PixelSectionTitle" android:text="@string/settings_section_advanced" />

            <com.google.android.material.card.MaterialCardView android:id="@+id/itemShowTutorial" style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_info" />
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" style="@style/PixelItemTitle"
                        android:text="@string/settings_show_tutorial" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/itemResetLayout" style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_grid" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_reset_layout" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_reset_layout_sub" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/itemResetSettings" style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_settings" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_reset_settings" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_reset_settings_sub" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/itemResetEverything" style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_uninstall"
                        android:tint="?attr/colorError" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle"
                            android:text="@string/settings_reset_everything"
                            android:textColor="?attr/colorError" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_reset_everything_sub" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ DATI E BACKUP (v27) ============ -->
            <TextView style="@style/PixelSectionTitle" android:text="@string/settings_section_backup" />

            <com.google.android.material.card.MaterialCardView android:id="@+id/itemHiddenApps" style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_hide" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_hidden_apps" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_hidden_apps_sub" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/itemBackupExport" style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_backup_export" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_backup_export" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_backup_export_sub" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/itemBackupImport" style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_backup_import" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_backup_import" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_backup_import_sub" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ SISTEMA ============ -->
            <TextView style="@style/PixelSectionTitle" android:text="@string/settings_section_general" />

            <com.google.android.material.card.MaterialCardView android:id="@+id/itemDefaultLauncher" style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_pin" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_default_launcher" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_default_launcher_sub" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/itemNotificationAccess" style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_circle" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_notification_access" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_notification_access_sub" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/itemAppInfo" style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_info" />
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" style="@style/PixelItemTitle"
                        android:text="@string/settings_app_info" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ INFO ============ -->
            <TextView style="@style/PixelSectionTitle" android:text="@string/settings_section_info" />

            <com.google.android.material.card.MaterialCardView style="@style/PixelCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="28dp"
                    android:paddingBottom="20dp">
                    <ImageView
                        android:id="@+id/appIconInfo"
                        android:layout_width="80dp"
                        android:layout_height="80dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/app_name"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:id="@+id/versionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/info_experimental_warn"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:textAllCaps="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" style="@style/PixelItemTitle"
                        android:text="@string/info_build_label" />
                    <TextView android:id="@+id/buildValue" style="@style/PixelItemSubtitle" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/itemCheipStudio" style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_pin" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/info_studio_label" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/info_studio_sub" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:id="@+id/itemContact" style="@style/PixelCard">
                <LinearLayout style="@style/PixelItem">
                    <ImageView style="@style/PixelItemIcon" android:src="@drawable/ic_info" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/PixelItemTitle" android:text="@string/settings_contact_label" />
                        <TextView style="@style/PixelItemSubtitle" android:text="@string/settings_contact_sub" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
