<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_speed_stats_light"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="3"
        android:baselineAligned="false">

        <!-- Colonna 1 RAM -->
        <LinearLayout 
            android:id="@+id/col1_root"
            android:layout_width="0dp" 
            android:layout_height="match_parent"
            android:layout_weight="1" 
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_widget_pill_ram"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">
            
            <TextView android:id="@+id/col1_value"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:textColor="#171515"
                android:textSize="28sp" 
                android:text="—" />
            
            <TextView 
                android:id="@+id/col1_subtitle"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#7AE582"
                android:textSize="11sp"
                android:text="RAM" />
        </LinearLayout>

        <!-- Colonna 2 Memoria -->
        <LinearLayout 
            android:id="@+id/col2_root"
            android:layout_width="0dp" 
            android:layout_height="match_parent"
            android:layout_weight="1" 
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_widget_pill_storage"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">
            
            <TextView android:id="@+id/col2_value"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:textColor="#171515"
                android:textSize="28sp" 
                android:text="—" />
            
            <TextView 
                android:id="@+id/col2_subtitle"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#82AAFF"
                android:textSize="11sp"
                android:text="MEM" />
        </LinearLayout>

        <!-- Colonna 3 Battery -->
        <LinearLayout 
            android:id="@+id/col3_root"
            android:layout_width="0dp" 
            android:layout_height="match_parent"
            android:layout_weight="1" 
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_widget_pill_battery"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">
            
            <TextView android:id="@+id/col3_value"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:textColor="#171515"
                android:textSize="28sp" 
                android:text="—" />
            
            <TextView 
                android:id="@+id/col3_subtitle"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFB86C"
                android:textSize="11sp"
                android:text="BAT" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
