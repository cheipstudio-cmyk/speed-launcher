<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_speed_stats_light"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="3"
        android:baselineAligned="false">

        <!-- RAM -->
        <LinearLayout 
            android:id="@+id/col1_root"
            android:layout_width="0dp" 
            android:layout_height="match_parent"
            android:layout_weight="1" 
            android:layout_margin="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_widget_pill_ram_light"
            android:padding="6dp">
            
            <ImageView
                android:id="@+id/col1_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_memory" />
            
            <TextView android:id="@+id/col1_value"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#171515"
                android:textSize="22sp" 
                android:text="—" />
            
            <TextView 
                android:id="@+id/col1_label"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#2E7D4F"
                android:textSize="10sp"
                android:text="RAM" />
            
            <TextView 
                android:id="@+id/col1_subtitle"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#802E7D4F"
                android:textSize="9sp"
                android:text="" />
        </LinearLayout>

        <!-- Memoria -->
        <LinearLayout 
            android:id="@+id/col2_root"
            android:layout_width="0dp" 
            android:layout_height="match_parent"
            android:layout_weight="1" 
            android:layout_margin="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_widget_pill_storage_light"
            android:padding="6dp">
            
            <ImageView
                android:id="@+id/col2_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_storage" />
            
            <TextView android:id="@+id/col2_value"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#171515"
                android:textSize="22sp" 
                android:text="—" />
            
            <TextView 
                android:id="@+id/col2_label"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#3D5AAA"
                android:textSize="10sp"
                android:text="MEM" />
            
            <TextView 
                android:id="@+id/col2_subtitle"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#803D5AAA"
                android:textSize="9sp"
                android:text="" />
        </LinearLayout>

        <!-- Battery -->
        <LinearLayout 
            android:id="@+id/col3_root"
            android:layout_width="0dp" 
            android:layout_height="match_parent"
            android:layout_weight="1" 
            android:layout_margin="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_widget_pill_battery_light"
            android:padding="6dp">
            
            <ImageView
                android:id="@+id/col3_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_battery" />
            
            <TextView android:id="@+id/col3_value"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#171515"
                android:textSize="22sp" 
                android:text="—" />
            
            <TextView 
                android:id="@+id/col3_label"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#B07840"
                android:textSize="10sp"
                android:text="BAT" />
            
            <TextView 
                android:id="@+id/col3_subtitle"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#80B07840"
                android:textSize="9sp"
                android:text="" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
