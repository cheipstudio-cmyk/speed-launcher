<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_speed_stats_light"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="3">

        <!-- RAM -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/widget_ram"
                android:textColor="#666677" android:textSize="11sp"
                android:fontFamily="sans-serif-medium" android:textAllCaps="true"
                android:letterSpacing="0.06" />
            <TextView android:id="@+id/ramPct"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="#1A1A1F"
                android:textSize="22sp" android:fontFamily="sans-serif-medium" android:text="—" />
            <ProgressBar android:id="@+id/ramProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent" android:layout_height="8dp"
                android:layout_marginTop="6dp" android:layout_marginHorizontal="8dp"
                android:max="100" android:progress="0"
                android:progressDrawable="@drawable/progress_widget_ram_light" />
            <TextView android:id="@+id/ramSubtitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="#888899"
                android:textSize="10sp" android:text="" />
        </LinearLayout>

        <!-- Storage -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/widget_storage"
                android:textColor="#666677" android:textSize="11sp"
                android:fontFamily="sans-serif-medium" android:textAllCaps="true"
                android:letterSpacing="0.06" />
            <TextView android:id="@+id/storPct"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="#1A1A1F"
                android:textSize="22sp" android:fontFamily="sans-serif-medium" android:text="—" />
            <ProgressBar android:id="@+id/storProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent" android:layout_height="8dp"
                android:layout_marginTop="6dp" android:layout_marginHorizontal="8dp"
                android:max="100" android:progress="0"
                android:progressDrawable="@drawable/progress_widget_storage_light" />
            <TextView android:id="@+id/storSubtitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="#888899"
                android:textSize="10sp" android:text="" />
        </LinearLayout>

        <!-- Battery -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/widget_battery"
                android:textColor="#666677" android:textSize="11sp"
                android:fontFamily="sans-serif-medium" android:textAllCaps="true"
                android:letterSpacing="0.06" />
            <TextView android:id="@+id/battPct"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="#1A1A1F"
                android:textSize="22sp" android:fontFamily="sans-serif-medium" android:text="—" />
            <ProgressBar android:id="@+id/battProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent" android:layout_height="8dp"
                android:layout_marginTop="6dp" android:layout_marginHorizontal="8dp"
                android:max="100" android:progress="0"
                android:progressDrawable="@drawable/progress_widget_battery_light" />
            <TextView android:id="@+id/battSubtitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="#888899"
                android:textSize="10sp" android:text="" />
        </LinearLayout>
    </LinearLayout>

    <ImageView android:id="@+id/refreshBtn"
        android:clickable="true" android:focusable="true"
        android:layout_width="32dp" android:layout_height="32dp"
        android:layout_gravity="top|end" android:padding="6dp"
        android:background="@drawable/bg_widget_refresh_btn_light"
        android:src="@drawable/ic_refresh_widget" android:visibility="gone" />
</FrameLayout>
