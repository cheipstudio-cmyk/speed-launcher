<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_speed_stats_light"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="3"
        android:gravity="center"
        android:baselineAligned="false">

        <LinearLayout 
            android:id="@+id/col1_root"
            android:layout_width="0dp" 
            android:layout_height="match_parent"
            android:layout_weight="1" 
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp">
            
            <ImageView
                android:id="@+id/col1_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_widget_memory" />
            
            <TextView android:id="@+id/col1_value"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#1A1A1A"
                android:textSize="22sp"
                android:text="—" />
            
            <ProgressBar
                android:id="@+id/col1_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#1F8048"
                android:progressBackgroundTint="#33000000" />
            
            <TextView 
                android:id="@+id/col1_label"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#1F8048"
                android:textSize="11sp"
                android:text="RAM" />
            
            <TextView 
                android:id="@+id/col1_subtitle"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#80000000"
                android:textSize="9sp"
                android:text="" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/col2_root"
            android:layout_width="0dp" 
            android:layout_height="match_parent"
            android:layout_weight="1" 
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp">
            
            <ImageView
                android:id="@+id/col2_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_widget_storage" />
            
            <TextView android:id="@+id/col2_value"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#1A1A1A"
                android:textSize="22sp"
                android:text="—" />
            
            <ProgressBar
                android:id="@+id/col2_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#1F4DB0"
                android:progressBackgroundTint="#33000000" />
            
            <TextView 
                android:id="@+id/col2_label"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#1F4DB0"
                android:textSize="11sp"
                android:text="MEMORIA" />
            
            <TextView 
                android:id="@+id/col2_subtitle"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#80000000"
                android:textSize="9sp"
                android:text="" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/col3_root"
            android:layout_width="0dp" 
            android:layout_height="match_parent"
            android:layout_weight="1" 
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp">
            
            <ImageView
                android:id="@+id/col3_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_widget_battery" />
            
            <TextView android:id="@+id/col3_value"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#1A1A1A"
                android:textSize="22sp"
                android:text="—" />
            
            <ProgressBar
                android:id="@+id/col3_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#A0541F"
                android:progressBackgroundTint="#33000000" />
            
            <TextView 
                android:id="@+id/col3_label"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#A0541F"
                android:textSize="11sp"
                android:text="BATTERIA" />
            
            <TextView 
                android:id="@+id/col3_subtitle"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#80000000"
                android:textSize="9sp"
                android:text="" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
