<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_speed_stats_transparent"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="3"
        android:gravity="center"
        android:baselineAligned="false">

        <LinearLayout 
            android:id="@+id/col1_root"
            android:layout_width="0dp" 
            android:layout_height="match_parent"
            android:layout_weight="1" 
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp">
            
            <ImageView
                android:id="@+id/col1_ring"
                android:layout_width="62dp"
                android:layout_height="62dp" />
            
            <TextView 
                android:id="@+id/col1_label"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:text="RAM" />
            
            <TextView 
                android:id="@+id/col1_subtitle"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#80FFFFFF"
                android:textSize="9sp"
                android:text="" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/col2_root"
            android:layout_width="0dp" 
            android:layout_height="match_parent"
            android:layout_weight="1" 
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp">
            
            <ImageView
                android:id="@+id/col2_ring"
                android:layout_width="62dp"
                android:layout_height="62dp" />
            
            <TextView 
                android:id="@+id/col2_label"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#60A5FA"
                android:textSize="11sp"
                android:text="MEMORIA" />
            
            <TextView 
                android:id="@+id/col2_subtitle"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#80FFFFFF"
                android:textSize="9sp"
                android:text="" />
        </LinearLayout>

        <LinearLayout 
            android:id="@+id/col3_root"
            android:layout_width="0dp" 
            android:layout_height="match_parent"
            android:layout_weight="1" 
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp">
            
            <ImageView
                android:id="@+id/col3_ring"
                android:layout_width="62dp"
                android:layout_height="62dp" />
            
            <TextView 
                android:id="@+id/col3_label"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FB923C"
                android:textSize="11sp"
                android:text="BATTERIA" />
            
            <TextView 
                android:id="@+id/col3_subtitle"
                android:layout_width="wrap_content" 
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#80FFFFFF"
                android:textSize="9sp"
                android:text="" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
