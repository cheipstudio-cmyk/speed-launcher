<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_speed_stats"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:weightSum="3">

    <!-- RAM -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_ram"
            android:textColor="#B0B0BD"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/ramPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:text="—" />

        <ProgressBar
            android:id="@+id/ramProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#A6E3A1"
            android:progressBackgroundTint="#26FFFFFF" />

        <TextView
            android:id="@+id/ramSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B0B0BD"
            android:textSize="10sp"
            android:text="" />
    </LinearLayout>

    <!-- Storage -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_storage"
            android:textColor="#B0B0BD"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/storPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:text="—" />

        <ProgressBar
            android:id="@+id/storProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#89B4FA"
            android:progressBackgroundTint="#26FFFFFF" />

        <TextView
            android:id="@+id/storSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B0B0BD"
            android:textSize="10sp"
            android:text="" />
    </LinearLayout>

    <!-- Batteria -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_battery"
            android:textColor="#B0B0BD"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/battPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:text="—" />

        <ProgressBar
            android:id="@+id/battProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FFD68C"
            android:progressBackgroundTint="#26FFFFFF" />

        <TextView
            android:id="@+id/battSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B0B0BD"
            android:textSize="10sp"
            android:text="" />
    </LinearLayout>
</LinearLayout>
