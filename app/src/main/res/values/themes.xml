<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SpeedLauncher" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="materialAlertDialogTheme">@style/PixelAlertDialog</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="bottomSheetDialogTheme">@style/Theme.SpeedLauncher.BottomSheet</item>
    </style>

    <style name="Theme.SpeedLauncher.Settings" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="materialAlertDialogTheme">@style/PixelAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/Theme.SpeedLauncher.BottomSheet</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowAnimationStyle">@style/SpeedLauncherActivityAnim</item>
    </style>
    
    <style name="SpeedLauncherActivityAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left_back</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="Theme.SpeedLauncher.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.SpeedLauncher.BottomSheet</item>
    </style>

    <style name="Widget.SpeedLauncher.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.SpeedLauncher.BottomSheet</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
    </style>

    <style name="ShapeAppearance.SpeedLauncher.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>


    <style name="Theme.SpeedLauncher.Rss" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowAnimationStyle">@style/SpeedLauncherRssAnim</item>
    </style>
    
    <style name="SpeedLauncherRssAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/rss_slide_in_right_full</item>
        <item name="android:activityOpenExitAnimation">@anim/home_slide_out_partial</item>
        <item name="android:activityCloseEnterAnimation">@anim/home_slide_in_back</item>
        <item name="android:activityCloseExitAnimation">@anim/rss_slide_out_left_full</item>
    </style>

    <style name="PixelAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="dialogCornerRadius">28dp</item>
        <item name="materialAlertDialogTitlePanelStyle">@style/PixelAlertDialogTitle</item>
    </style>
    
    <style name="PixelAlertDialogTitle" parent="MaterialAlertDialog.Material3.Title.Panel">
    </style>
</resources>
