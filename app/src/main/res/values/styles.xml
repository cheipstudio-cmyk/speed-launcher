<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- v25: STILI PIXEL ANDROID PURO -->

    <!-- Section title (grigio, sopra le card, sans-serif normale) -->
    <style name="PixelSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">52dp</item>
        <item name="android:paddingBottom">20dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Card singola per item -->
    <style name="PixelCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">12dp</item>
        <item name="android:layout_marginVertical">4dp</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Card grouped (multiple items) - per sezioni con più scelte tipo radio -->
    <style name="PixelCardGroup" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:layout_marginVertical">3dp</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Item dentro la card (icona + testo + sottotesto) -->
    <style name="PixelItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingVertical">14dp</item>
    </style>

    <style name="PixelItemClickable" parent="PixelItem">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Icona item: 24dp, monocromatica, on-surface (NON colorPrimary) -->
    <style name="PixelItemIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginEnd">22dp</item>
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <!-- v39: Pixel-style colored settings icon: contenitore 32dp con bg colorato -->
    <style name="PixelColoredIconWrap">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">18dp</item>
        <item name="android:padding">7dp</item>
    </style>
    <!-- L'icona dentro: 18dp, tint nero pieno (contrasto sui pastelli) -->
    <style name="PixelColoredIcon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:tint">#1B1B1F</item>
    </style>

    <!-- Titolo riga 17sp medium -->
    <style name="PixelItemTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Sottotitolo riga 14sp grigio -->
    <style name="PixelItemSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Big title pagina -->
    <style name="PixelPageTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">28dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">36sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Radio inside grouped card -->
    <style name="PixelRadio">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Divider dentro la card grouped -->
    <style name="PixelGroupDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">68dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
        <item name="android:alpha">0.3</item>
    </style>

    <!-- ===== Compat: vecchi stili Card/Moto puntano ai Pixel ===== -->
    <style name="SettingsCard" parent="PixelCard" />
    <style name="SettingsCardAlt" parent="PixelCard" />
    <style name="SettingsCardInner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingVertical">8dp</item>
    </style>
    <style name="CardSectionHeader" parent="PixelItem" />
    <style name="CardSectionIcon" parent="PixelItemIcon" />
    <style name="CardSectionLabel" parent="PixelItemTitle" />
    <style name="CardRow" parent="PixelItem" />
    <style name="CardRowClickable" parent="PixelItemClickable" />
    <style name="CardTitle" parent="PixelItemTitle" />
    <style name="CardSubtitle" parent="PixelItemSubtitle" />
    <style name="CardRadio" parent="PixelRadio" />
    <style name="CardInnerDivider" parent="PixelGroupDivider" />
    <style name="MotoSectionRow" parent="PixelItem" />
    <style name="MotoSectionIcon" parent="PixelItemIcon" />
    <style name="MotoSectionLabel" parent="PixelItemTitle" />
    <style name="MotoSection" parent="PixelSectionTitle" />
    <style name="MotoDivider" parent="PixelGroupDivider" />
    <style name="MotoRow" parent="PixelItem" />
    <style name="MotoRowClickable" parent="PixelItemClickable" />
    <style name="MotoTitle" parent="PixelItemTitle" />
    <style name="MotoSubtitle" parent="PixelItemSubtitle" />
    <style name="MotoRadio" parent="PixelRadio" />

    <style name="WidgetPickerSheetTheme" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/WidgetPickerSheetStyle</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>
    <style name="WidgetPickerSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="behavior_skipCollapsed">true</item>
        <item name="behavior_fitToContents">false</item>
        <item name="shapeAppearanceOverlay">@style/PixelBottomSheetShape</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
    </style>
    
    <style name="PixelBottomSheetShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- v135: theme home con windowShowWallpaper per blur funzionante -->
    <style name="Theme.SpeedLauncher.Home" parent="Theme.SpeedLauncher">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
    </style>


    <style name="PixelExpandedTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">36sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="PixelCollapsedTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- v191: M3 Expressive typography (Google Sans-like compact) -->
    <style name="PixelTitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="PixelTitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>
    <style name="PixelBodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="PixelBodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="RssEdgeShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomRight">20dp</item>
    </style>
</resources>
